APP_ENV=hackathon
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173
DEFAULT_APP_MODE=demo
UPLOAD_DIR=backend/uploads
CHROMA_PATH=backend/chroma
AI_PROVIDER=demo
# Optional live AI — backend-only. Demo continues if the key is missing or the provider fails.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com
# AI_TIMEOUT_SECONDS=10
# AI_MAX_OUTPUT_TOKENS=800
# URL_CACHE_TTL_SECONDS=21600

# Bolna live calling — leave unset to stay in demo mode.
# BOLNA_API_KEY=
# BOLNA_FROM_PHONE=+1XXXXXXXXXX
# BOLNA_WEBHOOK_URL=https://halolike-jenee-cressiest.ngrok-free.dev/api/v1/bolna/webhook

# Calendly — auto-populated by /api/v1/calendly/oauth/callback or /register-webhook
# CALENDLY_URL=https://calendly.com/northwind-digital/consultation
# CALENDLY_WEBHOOK_SECRET=
# CALENDLY_WEBHOOK_TOLERANCE_SECONDS=180
# API_BASE_URL=http://localhost:8000

# Calendly OAuth access token. Required scope: scheduled_events:write
# (so we can POST /scheduled_events on behalf of an invitee and trigger
# Calendly's built-in confirmation email). Default OAuth grants only
# webhooks:*; you must request scheduled_events:write explicitly when
# building the OAuth app at https://developer.calendly.com.
# If unset, schedule_callback falls back to Twilio SMS (when configured).
# CALENDLY_ACCESS_TOKEN=
# Optional: pin the event_type URI to skip the /event_types discovery call.
# Otherwise we use the first active event_type for the authenticated user.
# CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/XXXXXXXX

# Placeholder email applied to any lead missing one — needed so the
# Calendly "send confirmation email" path always has a recipient.
# Bulk-apply existing leads via:
#   sqlite3 backend/data/sales_agent.db \
#     "UPDATE leads SET payload = json_set(payload, '\$.email',
#        '23it021@charusat.edu.in')
#      WHERE json_extract(payload, '\$.email') IS NULL
#         OR json_extract(payload, '\$.email') = '';"
# DEFAULT_LEAD_EMAIL=23it021@charusat.edu.in
